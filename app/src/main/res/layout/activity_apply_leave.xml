<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_construction_plan"
    tools:context=".ApplyLeave">

    <!-- Main screen content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Existing App Header -->
        <include layout="@layout/view_header" />

        <!-- Form Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="105dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Page Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apply for Leave"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Submit a leave request for your supervisor to review."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />


                <!-- Leave Form Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="5dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Form Heading -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Leave Details"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="18dp"
                            android:text="Please provide the details of your requested leave."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />


                        <!-- Leave Type -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilLeaveType"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Leave Type"
                            android:textColorHint="#94A3B8"
                            app:boxBackgroundColor="@android:color/white"
                            app:boxStrokeColor="#000000"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusTopStart="14dp"
                            app:endIconMode="dropdown_menu"
                            app:startIconTint="#94A3B8"
                            app:startIconDrawable="@android:drawable/ic_menu_agenda">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/actLeaveType"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:textSize="15sp"
                                tools:text="Annual Leave" />

                        </com.google.android.material.textfield.TextInputLayout>


                        <!-- Start Date -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilStartDate"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:hint="Start Date"
                            android:textColorHint="#94A3B8"
                            app:boxBackgroundColor="@android:color/white"
                            app:boxStrokeColor="#000000"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusTopStart="14dp"
                            app:startIconTint="#94A3B8"
                            app:startIconDrawable="@android:drawable/ic_menu_my_calendar">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etStartDate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:focusable="false"
                                android:inputType="none"
                                android:textSize="15sp" />

                        </com.google.android.material.textfield.TextInputLayout>


                        <!-- End Date -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilEndDate"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:hint="End Date"
                            android:textColorHint="#94A3B8"
                            app:boxBackgroundColor="@android:color/white"
                            app:boxStrokeColor="#000000"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusTopStart="14dp"
                            app:startIconTint="#94A3B8"
                            app:startIconDrawable="@android:drawable/ic_menu_my_calendar">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEndDate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:focusable="false"
                                android:inputType="none"
                                android:textSize="15sp" />

                        </com.google.android.material.textfield.TextInputLayout>


                        <!-- Reason -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilReason"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:hint="Reason for Leave"
                            app:boxBackgroundColor="@android:color/white"
                            app:boxStrokeColor="#000000"
                            android:textColorHint="#94A3B8"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusTopStart="14dp"
                            app:startIconDrawable="@android:drawable/ic_menu_edit"
                            app:startIconTint="#94A3B8">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etReason"
                                android:layout_width="match_parent"
                                android:layout_height="120dp"
                                android:gravity="top|start"
                                android:inputType="textCapSentences|textMultiLine"
                                android:maxLines="5"
                                android:paddingTop="14dp"
                                android:textSize="15sp" />

                        </com.google.android.material.textfield.TextInputLayout>


                        <!-- Submit Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSubmitLeave"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="22dp"
                            android:backgroundTint="@color/brand_blue_primary"
                            android:text="Submit Leave Request"
                            android:textColor="@android:color/white"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:icon="@android:drawable/ic_menu_send"
                            app:iconGravity="textStart"
                            app:iconPadding="8dp"
                            app:iconTint="@android:color/white" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Small Information Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="#E2E8F0"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Information"
                            android:src="@android:drawable/ic_dialog_info" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="Your request will remain pending until it has been reviewed by your supervisor."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>


    <!-- Existing Floating Bottom Navigation -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/floatingBottomNav"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:elevation="14dp"
        app:cardBackgroundColor="#2A384C"
        app:cardCornerRadius="36dp"
        app:cardElevation="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="4">


            <!-- Alerts -->
            <LinearLayout
                android:id="@+id/navNotifications"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="Alerts"
                    android:src="@drawable/ic_nav_alerts"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Alerts"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- Home -->
            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="Home"
                    android:src="@drawable/ic_nav_home"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Home"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>
            <!-- Attendance -->
            <LinearLayout
                android:id="@+id/navAttendance"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="Attendance"
                    android:src="@drawable/ic_nav_attendance"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Attendance"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- Leaves -->
            <LinearLayout
                android:id="@+id/navLeaveRequest"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="Leaves"
                    android:src="@drawable/ic_nav_leaves"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Leaves"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>



        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>