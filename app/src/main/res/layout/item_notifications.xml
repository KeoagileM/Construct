<?xml version="1.0" encoding="utf-8"?>


<com.google.android.material.card.MaterialCardView
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:id="@+id/notificationCard"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginBottom="14dp"
android:clickable="true"
android:focusable="true"
android:foreground="?attr/selectableItemBackground"
app:cardBackgroundColor="#FFFFFF"
app:cardCornerRadius="18dp"
app:cardElevation="4dp"
app:strokeWidth="0dp">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Notification Icon -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_notifications_icon"
        android:gravity="center">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="Notification"
            android:src="@drawable/ic_nav_alerts"
            app:tint="#FFFFFF" />

    </FrameLayout>

    <!-- Notification Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Title + Unread Dot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNotificationTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Important Site Update"
                android:textColor="#1E293B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Unread indicator -->
            <View
                android:id="@+id/unreadIndicator"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_uread_dot" />

        </LinearLayout>

        <!-- Sender -->
        <TextView
            android:id="@+id/tvNotificationSender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Sent by Supervisor"
            android:textColor="#475569"
            android:textSize="13sp" />

        <!-- Date & Time -->
        <TextView
            android:id="@+id/tvNotificationDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="05 Oct 2026 • 14:35"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <!-- Message Preview -->
        <TextView
            android:id="@+id/tvNotificationPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Please report to the site office before your shift..."
            android:textColor="#64748B"
            android:textSize="13sp" />

        <!-- Read Status -->
        <TextView
            android:id="@+id/tvNotificationReadStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="Unread"
            android:textColor="#2563EB"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>

</com.google.android.material.card.MaterialCardView>