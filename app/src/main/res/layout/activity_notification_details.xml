<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_construction_plan"
    tools:context=".NotificationDetails">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <include
            layout="@layout/view_header" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="30dp">

                <!-- Back Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackNotifications"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="0dp"
                    android:paddingEnd="12dp"
                    android:text="‹  Notifications"
                    android:textColor="#334155"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Main Notification Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="5dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Notification Icon -->
                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_notifications_icon"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="38dp"
                                android:contentDescription="Notification"
                                android:src="@drawable/ic_nav_alerts"
                                app:tint="#FFFFFF" />

                        </FrameLayout>

                        <!-- Title -->
                        <TextView
                            android:id="@+id/tvDetailTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="Important Site Update"
                            android:textColor="#1E293B"
                            android:textSize="23sp"
                            android:textStyle="bold" />

                        <!-- Sender -->
                        <TextView
                            android:id="@+id/tvDetailSender"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="Sent by Supervisor"
                            android:textColor="#475569"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- Date and Time -->
                        <TextView
                            android:id="@+id/tvDetailDateTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="05 October 2026 • 14:35"
                            android:textColor="#94A3B8"
                            android:textSize="13sp" />

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="20dp"
                            android:background="#E2E8F0" />

                        <!-- Message Label -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Message"
                            android:textColor="#334155"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- Full Message -->
                        <TextView
                            android:id="@+id/tvDetailMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:lineSpacingExtra="5dp"
                            android:text="Please report to the site office before your shift begins. There will be an important safety briefing regarding the upcoming construction work. Make sure you arrive at least 15 minutes early."
                            android:textColor="#475569"
                            android:textSize="15sp" />

                        <!-- Read Status -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/detailReadIndicator"
                                android:layout_width="9dp"
                                android:layout_height="9dp"
                                android:background="@drawable/bg_uread_dot" />

                            <TextView
                                android:id="@+id/tvDetailReadStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Unread"
                                android:textColor="#2563EB"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</FrameLayout>